{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ai/[route].js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "server/models/**",
      "excludeFiles": "{node_modules/onnxruntime-node/bin/napi-v6/darwin/**,node_modules/onnxruntime-node/bin/napi-v6/win32/**,node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**,public/test samples/**}"
    }
  },
  "crons": [{ "path": "/api/keepalive", "schedule": "0 3 * * *" }],
  "rewrites": [
    { "source": "/healthz", "destination": "/api/healthz" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
