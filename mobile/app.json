{
  "expo": {
    "name": "HeyHanger",
    "slug": "closiq",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "closiq",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F2E9",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.closiq.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.closiq.app",
      "adaptiveIcon": {
        "backgroundColor": "#6B5A3D",
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/app-icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/heyhanger-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F2E9"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "HeyHanger uses your camera to capture photos of clothing you own.",
          "photosPermission": "HeyHanger uses your photo library to catalog clothing you already own.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HeyHanger uses your location to provide local weather and improve outfit recommendations."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "./plugins/with-android-build-compat"
    ],
    "extra": {
      "eas": {
        "projectId": "859d629b-60ac-4860-b325-16eee1c362d7"
      }
    },
    "owner": "vudigapranav",
    "updates": {
      "url": "https://u.expo.dev/859d629b-60ac-4860-b325-16eee1c362d7"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
