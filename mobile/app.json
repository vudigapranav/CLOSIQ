{
  "expo": {
    "name": "CLOSIQ",
    "slug": "closiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "closiq",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F2E9",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.closiq.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.closiq.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F2E9",
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/app-icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/closiq-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F2E9"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "CLOSIQ uses your camera to capture photos of clothing you own.",
          "photosPermission": "CLOSIQ uses your photo library to catalog clothing you already own.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CLOSIQ uses your location to provide local weather and improve outfit recommendations."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "859d629b-60ac-4860-b325-16eee1c362d7"
      }
    },
    "owner": "vudigapranav",
    "updates": {
      "url": "https://u.expo.dev/859d629b-60ac-4860-b325-16eee1c362d7"
    }
  }
}
