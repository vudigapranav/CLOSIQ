# CLOSIQ — Environment Configuration Template
# Copy this file to .env and fill in your real values.
# Do NOT commit .env or secret API keys to version control.
#
# GEMINI_API_KEY is read server-side ONLY (server/geminiServer.js). It is
# never sent to the browser — there is no VITE_-prefixed client-side
# equivalent, deliberately, so it can never end up in the built JS bundle.
# Without it, CLOSIQ runs in demo mode automatically.

GEMINI_API_KEY=your_gemini_api_key_here

# SUPABASE_URL / SUPABASE_ANON_KEY (Sprint M17) — used ONLY by
# server/authVerify.js to verify a mobile client's bearer token before
# proxying an /api/ai/* request to Gemini. These are the SAME public,
# Row-Level-Security-protected values the mobile app carries under
# EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY (see
# mobile/.env.example) — not a secret, no service-role key is used or
# needed anywhere in this project. Without these set, every /api/ai/*
# request is rejected with 401 (fails closed, same posture as a missing
# GEMINI_API_KEY) and the mobile app falls back to its local deterministic
# styling engine, exactly as it already does when the server is
# unreachable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
