# CLOSIQ — Environment Configuration Template
# Copy this file to .env and add your real Gemini API key.
# Do NOT commit .env or secret API keys to version control.
#
# GEMINI_API_KEY is read server-side ONLY (server/geminiServer.js). It is
# never sent to the browser — there is no VITE_-prefixed client-side
# equivalent, deliberately, so it can never end up in the built JS bundle.
# Without it, CLOSIQ runs in demo mode automatically.

GEMINI_API_KEY=your_gemini_api_key_here
